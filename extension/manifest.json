{
  "manifest_version": 3,
  "name": "Quest Log",
  "version": "0.1.0",
  "description": "Clip postings and autofill applications from your Quest Log. You always click submit.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["http://localhost:3000/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "Quest Log" },
  "options_page": "options.html",
  "icons": { "128": "icon.png" }
}
