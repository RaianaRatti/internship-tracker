# Copy to .env.local and fill in what you need. Everything is optional except APP_SECRET.

# Encrypts OAuth tokens and EEO answers at rest. Generate with: openssl rand -hex 32
APP_SECRET=

# SQLite database file (local-first)
DATABASE_URL=file:./data/quest.db

# Claude API — powers cover letters, essays, parsing, email classification.
ANTHROPIC_API_KEY=
# Optional model overrides (defaults from PLAN.md §6)
QUEST_GEN_MODEL=claude-sonnet-5-5
QUEST_FAST_MODEL=claude-haiku-4-5

# Gmail sync (PLAN.md §7). Create an OAuth "Web application" client in Google Cloud,
# enable the Gmail API, add yourself as a test user, and set the redirect URI below.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/gmail/callback

# Optional: OpenAlex API key for the faculty finder (free at openalex.org/settings/api)
OPENALEX_API_KEY=
# Contact email sent with polite crawler requests
CRAWLER_CONTACT=
